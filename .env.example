# Banco Postgres (na Vercel, a integração Neon cria esta variável sozinha)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# Opcional: segredo da sessão de login (se vazio, é derivado do DATABASE_URL)
AUTH_SECRET=
# IA: na Vercel usa o AI Gateway automaticamente. Fora da Vercel, defina AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
# Opcional: modelo de IA (padrão google/gemini-2.5-flash)
AI_MODEL=
